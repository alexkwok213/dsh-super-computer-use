{
  "name": "dsh-super-computer-use",
  "description": "Pure DeepSeek Harness plugin for macOS Computer Use: 20 cu_* tools including cu_route/cu_discover capability routing, floating capsule, target halo, and inline web preview. Zero external dependencies, prebuilt universal binary, no Xcode or launchd required.",
  "version": "0.18.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./core": {
      "default": "./lib/core.mjs"
    },
    "./client": "./client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "client.js",
    "lib",
    "locale",
    "skill",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "LICENSE",
    "engine"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "macos",
    "desktop-automation",
    "accessibility",
    "ai-agent",
    "screen-control"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.5-rc.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.3 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.3 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "build:bin": "./scripts/build-universal.sh",
    "test": "node scripts/test-isolated.mjs",
    "test:unit": "node scripts/test-isolated.mjs test/visual_feedback.mjs test/verification.mjs test/preview_budget.mjs test/identity.mjs test/capability.mjs test/plugin_observation.mjs test/plugin_lifecycle.mjs test/capture_daemon.mjs",
    "test:desktop": "node scripts/test-isolated.mjs test/core.test.mjs",
    "bench": "node bench/run.mjs",
    "dev:sync": "node scripts/dev-sync.mjs",
    "dev:sync:check": "node scripts/dev-sync.mjs --check-only",
    "release": "node scripts/release.mjs"
  },
  "icon": "assets/icon.png"
}
